// Integer-only fragment of tests/ir/expr/variadic.ir.
//
// The upstream file is skipped by FVExport because of its non-integer Math
// literals (ADR-5 restricts Math to Z), which left VOp.Min / VOp.Max with no
// differential coverage.  Every line below is copied verbatim from the
// upstream file; only the 3.2 / 2.4 / 3.3 cases are dropped.
@main def main() = {
  assert (= (min 1 2 3) 1)
  assert (= (min -INF 0 1) -INF)
  assert (= (min +INF 0 1) 0)
  assert (= (min +INF +INF +INF) +INF)
  assert (= (max 1 2 3) 3)
  assert (= (max -INF 0 1) 1)
  assert (= (max +INF 0 1) +INF)
  assert (= (max -INF -INF -INF) -INF)
}
