#!/bin/bash
# ==============================================================================
# ESMeta release driver
#
# Walks through steps 1-6 of the release process described in the wiki:
#   https://github.com/es-meta/esmeta/wiki/How-to-Release
# Every step explains itself and waits for your confirmation ([Y/n/q]).
# Steps 7-10 need forks and pull requests, so they are printed as manual
# instructions once step 6 finishes.
#
# If any step fails, the script stops WITHOUT rolling anything back, and tells
# you what has been done and what is left to do by hand.
#
# All development happens on `main`, which accepts changes only through pull
# requests. The release commits (.mailmap and the version bump) are made on the
# branch release/v<semver>, merged by a pull request, and the resulting commit
# on `main` gets the tag v<semver>. With the GitHub CLI (`gh`) logged in, the
# script opens and merges that pull request itself, asking first each time.
#
# Usage: scripts/release <semver>          e.g. scripts/release 0.9.0
# ==============================================================================

set -u

# Never hand output to a pager: this script is a prompt-driven flow and a pager
# would swallow the terminal while waiting for input.
export GIT_PAGER=cat
export PAGER=cat

# ------------------------------------------------------------------------------
# output helpers
# ------------------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

mkdir -p logs
LOG=logs/release
: >"$LOG"

say()  { echo -e "$1" | tee -a "$LOG"; }
ok()   { say "${GREEN}✓${NC} $1"; }
warn() { say "${YELLOW}!${NC} $1"; }
err()  { say "${RED}✗${NC} $1"; }
rule() { say "${CYAN}------------------------------------------------------------${NC}"; }

# ------------------------------------------------------------------------------
# step bookkeeping
# ------------------------------------------------------------------------------
declare -a COMPLETED=()
declare -a SKIPPED=()
STEP_NO=0
STEP_TITLE=""
TOTAL=6

begin() { # begin <no> <title>
  STEP_NO="$1"; STEP_TITLE="$2"
  say ""
  rule
  say "${BOLD}[$STEP_NO/$TOTAL] $STEP_TITLE${NC}"
  rule
}

finish() { COMPLETED+=("$STEP_NO. $STEP_TITLE"); ok "done"; }

skip() { SKIPPED+=("$STEP_NO. $STEP_TITLE"); warn "skipped"; }

# confirm: Enter or y -> run, n -> skip the step, q -> quit early
confirm() {
  if [ ! -t 0 ]; then
    err "This script is interactive; run it from a terminal."
    exit 1
  fi
  local ans
  while true; do
    printf "${CYAN}Proceed? [Y/n/q] ${NC}"
    read -r ans
    case "$ans" in
      "" | y | Y) return 0 ;;
      n | N) skip; return 1 ;;
      q | Q) say ""; warn "Stopped at your request."; summary; manual_from "$STEP_NO"; exit 0 ;;
      *) echo "Please answer y (or Enter), n, or q." ;;
    esac
  done
}

summary() {
  say ""
  rule
  say "${BOLD}What has been done${NC}"
  rule
  if [ ${#COMPLETED[@]} -eq 0 ]; then
    say "  (nothing)"
  else
    for s in "${COMPLETED[@]}"; do say "  ${GREEN}✓${NC} $s"; done
  fi
  if [ ${#SKIPPED[@]} -gt 0 ]; then
    say ""
    say "${BOLD}Skipped${NC}"
    for s in "${SKIPPED[@]}"; do say "  ${YELLOW}-${NC} $s"; done
  fi
}

# abort <reason>: never rolls back; reports state and what is left
abort() {
  say ""
  err "${BOLD}[$STEP_NO/$TOTAL] $STEP_TITLE failed.${NC}"
  say "  Reason: $1"
  summary
  say ""
  warn "Nothing was rolled back. The repository is left exactly as it is now,"
  warn "so you can inspect it, fix the problem, and redo the remaining steps."
  say "  Current branch : $(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
  say "  Working tree   : $(git status --porcelain | wc -l | tr -d ' ') changed file(s)"
  manual_from "$STEP_NO"
  say ""
  say "Full log: $LOG"
  exit 1
}

# run <description> <command...>
run() {
  local desc="$1"; shift
  say "  \$ $*"
  if ! "$@" >>"$LOG" 2>&1; then
    abort "$desc failed. See $LOG for the output."
  fi
}

# ------------------------------------------------------------------------------
# manual instructions (used both on success and on failure)
# ------------------------------------------------------------------------------
manual_from() { # manual_from <first-step-still-to-do>
  local from="$1"
  say ""
  rule
  say "${BOLD}Remaining work${NC}"
  rule
  [ "$from" -le 1 ] && say "  1. Update \`main\` and branch off:  git switch main && git pull --ff-only origin main && git switch -c $BRANCH"
  [ "$from" -le 2 ] && say "  2. Check that CI is green: https://github.com/es-meta/esmeta/actions"
  [ "$from" -le 3 ] && say "  3. Update .mailmap for new contributors, then commit it on $BRANCH."
  [ "$from" -le 4 ] && say "  4. Set the version to $VERSION in build.sbt and src/main/scala/esmeta/package.scala, run \`sbt release\` and \`sbt test\`, then commit on $BRANCH."
  [ "$from" -le 5 ] && {
    say "  5. Push $BRANCH, open a pull request, and squash-merge it once CI passes:"
    say "       git push -u origin $BRANCH"
    say "       https://github.com/$REPO/compare/main...$BRANCH?expand=1"
    say "     Then tag the merged commit:"
    say "       git switch main && git pull --ff-only origin main"
    say "       git diff --quiet $BRANCH main && git tag $TAG_NAME main && git push origin $TAG_NAME"
  }
  [ "$from" -le 6 ] && say "  6. Publish the ScalaDoc:  sbt ghpagesPushSite"
  manual_tail
}

manual_tail() {
  say ""
  rule
  say "${BOLD}Steps 7-10 and the downstream CI updates are always manual${NC}"
  rule
  say ""
  say "${BOLD} 7-9. Create the GitHub release${NC}"
  say "    https://github.com/es-meta/esmeta/releases/new?tag=$TAG_NAME"
  say "     7. Choose the new tag $TAG_NAME."
  say "     8. Click \"Generate release notes\"."
  say "     9. Append the contributor list:"
  say ""
  say "        The following list is automatically generated by \`git shortlog -sn --no-merges $PREV_TAG..$TAG_NAME\`:"
  say "        \`\`\`"
  if git rev-parse "$TAG_NAME" >/dev/null 2>&1; then
    git --no-pager shortlog -sn --no-merges "$PREV_TAG..$TAG_NAME" 2>/dev/null |
      sed 's/^/        /' | tee -a "$LOG"
  else
    say "        (run the command above once the tag $TAG_NAME exists)"
  fi
  say "        \`\`\`"
  say ""
  say "${BOLD}10. Update the website${NC}"
  say "    Copy README.md into index.md of es-meta/es-meta.github.io."
  say ""
  say "${BOLD}Update CI in tc39/ecma262${NC}"
  say "    In your fork, on a new branch:"
  say "    - .github/workflows/esmeta-installer/action.yml"
  say "        # $TAG_NAME"
  say "        echo \"ESMETA_VERSION=$TAG_COMMIT\" >> \$GITHUB_ENV"
  say "    - regenerate the ignore file:"
  say "        esmeta tycheck -tycheck:log -tycheck:ignore=esmeta-ignore.json -tycheck:update-ignore"
  say "    - commit, push, and open a pull request."
  say ""
  say "${BOLD}Update CI in tc39/test262${NC}"
  say "    In your fork, on a new branch:"
  say "    - .github/workflows/esmeta-test262.yml"
  say "        git clone --branch $TAG_NAME --depth 1 https://github.com/es-meta/esmeta.git \"\${ESMETA_HOME}\""
  say "    - commit, push, and open a pull request."
}

# ------------------------------------------------------------------------------
# argument and pre-flight checks
# ------------------------------------------------------------------------------
if [ "$#" -ne 1 ]; then
  echo "Usage: $0 <semver>"
  echo ""
  echo "We use Semantic Versioning 2.0 without pre-release names (https://semver.org)."
  echo "Example: $0 0.9.0"
  exit 1
fi

VERSION="$1"
TAG_NAME="v$VERSION"
# NOTE: bash uses POSIX ERE, which has no \d. Use [0-9] so that versions with
# multi-digit components (0.10.0) are accepted.
SEM_VER='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'
TAG_COMMIT="<commit of $TAG_NAME>"
BRANCH="release/$TAG_NAME"
REPO="es-meta/esmeta"

say "${BOLD}ESMeta release $TAG_NAME${NC}"
say ""
say "This walks through steps 1-6 of the release wiki, asking before each one."
say "Answer Enter or y to run a step, n to skip it, q to stop."
say ""

rule
say "${BOLD}[0/$TOTAL] Pre-flight checks${NC}"
rule

if ! [[ "$VERSION" =~ $SEM_VER ]]; then
  err "Invalid version name: $VERSION"
  exit 1
fi
ok "version name $VERSION"

for tool in git sbt java; do
  command -v "$tool" >/dev/null 2>&1 || { err "\`$tool\` is not installed."; exit 1; }
done
ok "git, sbt, and java are available"

[ -n "${ESMETA_HOME:-}" ] || { err "ESMETA_HOME is not set."; exit 1; }
ok "ESMETA_HOME=$ESMETA_HOME"

if ! git fetch --tags origin >/dev/null 2>&1; then
  err "Failed to fetch from origin."
  exit 1
fi
ok "fetched origin"

if git rev-parse "$TAG_NAME" >/dev/null 2>&1; then
  err "Tag or branch $TAG_NAME already exists."
  exit 1
fi
ok "$TAG_NAME does not exist yet"

if git rev-parse --verify --quiet "refs/heads/$BRANCH" >/dev/null ||
  git rev-parse --verify --quiet "refs/remotes/origin/$BRANCH" >/dev/null; then
  err "Branch $BRANCH already exists (locally or on origin)."
  exit 1
fi
ok "$BRANCH does not exist yet"

if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
  HAS_GH=1
  ok "gh is logged in; step 5 can open and merge the pull request"
else
  HAS_GH=0
  warn "gh is not available or not logged in; step 5 will ask you to open and merge the pull request yourself"
fi

git update-index --refresh >/dev/null 2>&1
if [ -n "$(git status --porcelain)" ]; then
  err "The working tree is not clean. Please commit or stash these first:"
  git status --short | sed 's/^/    /' | tee -a "$LOG"
  exit 1
fi
ok "working tree is clean"

PREV_TAG="$(git describe --tags --abbrev=0 2>/dev/null || echo '')"
if [ -n "$PREV_TAG" ]; then
  ok "previous release: $PREV_TAG"
else
  PREV_TAG="<previous tag>"
  warn "no previous tag found"
fi

# ------------------------------------------------------------------------------
# 1. update main
# ------------------------------------------------------------------------------
begin 1 "Update \`main\` and create $BRANCH"
say "The release is cut from \`main\`. Switches to \`main\`, pulls it, and"
say "creates the branch $BRANCH, where steps 3 and 4 commit."
if confirm; then
  run "switching to main" git switch main
  run "pulling main" git pull --ff-only origin main
  run "creating $BRANCH" git switch -c "$BRANCH"
  finish
fi

# Steps 3 and 4 commit, and must do so on the release branch, never on `main`.
require_branch() {
  [ "$(git rev-parse --abbrev-ref HEAD)" = "$BRANCH" ] ||
    abort "Not on $BRANCH (on $(git rev-parse --abbrev-ref HEAD)). Run step 1, or create the branch by hand."
}

# ------------------------------------------------------------------------------
# 2. check CI
# ------------------------------------------------------------------------------
begin 2 "Check that the CI is green"
say "All GitHub Actions runs for \`main\` must pass before releasing."
say "Also make sure \`esmeta test262-test\` passed on the full suite."
if confirm; then
  if command -v gh >/dev/null 2>&1; then
    say ""
    if ci_runs="$(gh run list --repo es-meta/esmeta --branch main --limit 5 2>&1)"; then
      say "$ci_runs"
    else
      warn "Could not query GitHub Actions; check the page manually."
    fi
    say ""
  fi
  say "  https://github.com/es-meta/esmeta/actions"
  printf "${CYAN}Is everything green (including test262-test)? [Y/n] ${NC}"
  read -r ci_ans
  case "$ci_ans" in
    "" | y | Y) finish ;;
    *) abort "CI is not green yet. Fix the failures and start again." ;;
  esac
fi

# ------------------------------------------------------------------------------
# 3. update .mailmap
# ------------------------------------------------------------------------------
begin 3 "Update \`.mailmap\` for new contributors"
say "Contributors since $PREV_TAG:"
say ""
git --no-pager shortlog -sne "$PREV_TAG..main" 2>/dev/null | sed 's/^/    /' | tee -a "$LOG"
say ""
say "If any name or address above is missing from .mailmap, edit it now in"
say "another terminal. This step commits .mailmap if you changed it."
if confirm; then
  require_branch
  if [ -n "$(git status --porcelain .mailmap)" ]; then
    run "staging .mailmap" git add .mailmap
    run "committing .mailmap" git commit -m "Update .mailmap"
    ok ".mailmap committed"
  else
    ok ".mailmap unchanged; nothing to commit"
  fi
  finish
fi

# ------------------------------------------------------------------------------
# 4. bump the version, rebuild, test, and commit
# ------------------------------------------------------------------------------
begin 4 "Set the version to $VERSION, rebuild, and test"
say "Updates:"
say "  - build.sbt                          version := \"$VERSION\""
say "  - src/main/scala/esmeta/package.scala VERSION = \"$VERSION\""
say "Then runs \`sbt release\` (format, assembly, and .completion) and \`sbt test\`."
say "\`sbt release\` regenerates .completion, which is tracked, so it is committed too."
say "This takes several minutes."
if confirm; then
  require_branch
  if [ "$(uname)" = "Darwin" ]; then SED_INPLACE=(-i '') ; else SED_INPLACE=(-i) ; fi

  run "updating build.sbt" \
    sed "${SED_INPLACE[@]}" -E "s/version := \"[^\"]+\"/version := \"$VERSION\"/" build.sbt
  grep -q "version := \"$VERSION\"" build.sbt || abort "build.sbt was not updated."
  ok "build.sbt"

  run "updating package.scala" \
    sed "${SED_INPLACE[@]}" -E "s/VERSION = \"[^\"]+\"/VERSION = \"$VERSION\"/" \
    src/main/scala/esmeta/package.scala
  grep -q "VERSION = \"$VERSION\"" src/main/scala/esmeta/package.scala || \
    abort "package.scala was not updated."
  ok "package.scala"

  # The welcome message in the installation section shows the version.
  if grep -q "ESMeta v[0-9]" README.md; then
    run "updating README.md" \
      sed "${SED_INPLACE[@]}" -E "s/ESMeta v[0-9][^ ]*/ESMeta $TAG_NAME/" README.md
    ok "README.md"
  else
    ok "README.md carries no version string; left untouched"
  fi

  # The installation section shows how to check out a release tag.
  if grep -qE "checkout v[0-9]+\.[0-9]+\.[0-9]+" README.md; then
    run "updating the release tag example in README.md" \
      sed "${SED_INPLACE[@]}" -E "s/checkout v[0-9]+\.[0-9]+\.[0-9]+/checkout $TAG_NAME/" README.md
    grep -q "checkout $TAG_NAME" README.md || abort "README.md was not updated."
    ok "README.md (release tag example)"
  fi

  say "  running \`sbt release\` (this takes a while)..."
  run "sbt release" sbt release
  ok "sbt release"

  say "  running \`sbt test\`..."
  run "sbt test" sbt test
  ok "sbt test"

  say ""
  say "Files to be committed:"
  git status --short | sed 's/^/    /' | tee -a "$LOG"
  say ""
  printf "${CYAN}Commit these as \"Update version\"? [Y/n] ${NC}"
  read -r commit_ans
  case "$commit_ans" in
    "" | y | Y)
      run "staging the version bump" git add -A
      run "committing the version bump" git commit -m "Update version"
      finish
      ;;
    *) abort "You declined the commit. The files above are still modified." ;;
  esac
fi

# ------------------------------------------------------------------------------
# 5. merge the release branch by a pull request, then tag
# ------------------------------------------------------------------------------
# ask_yn <question>: Enter or y -> 0, anything else -> 1
ask_yn() {
  local ans
  printf "${CYAN}$1 [Y/n] ${NC}"
  read -r ans
  case "$ans" in "" | y | Y) return 0 ;; *) return 1 ;; esac
}

begin 5 "Merge $BRANCH by a pull request, then tag $TAG_NAME"
say "${YELLOW}This is the first step that changes the remote repository.${NC}"
say "\`main\` accepts changes only through pull requests, so this"
say "  - pushes $BRANCH ($(git rev-parse --short "$BRANCH" 2>/dev/null)),"
say "  - opens a pull request and squash-merges it once its checks pass"
say "    (asking before each; without \`gh\`, you do these on GitHub), and"
say "  - tags the merged commit on \`main\` as $TAG_NAME and pushes the tag."
if confirm; then
  git rev-parse --verify --quiet "refs/heads/$BRANCH" >/dev/null ||
    abort "Branch $BRANCH does not exist. Run steps 1-4 first."
  run "pushing $BRANCH" git push -u origin "$BRANCH"
  ok "pushed $BRANCH"

  COMPARE_URL="https://github.com/$REPO/compare/main...$BRANCH?expand=1"
  PR_OPEN=0
  if [ "$HAS_GH" = 1 ] && ask_yn "Open the pull request \"Update version to $TAG_NAME\" with gh?"; then
    PR_BODY="Release $TAG_NAME: updates the version"
    [ -n "$(git diff --name-only "main...$BRANCH" -- .mailmap)" ] && PR_BODY="$PR_BODY and \`.mailmap\`"
    PR_BODY="$PR_BODY.

Contributors since $PREV_TAG (\`git shortlog -sn --no-merges $PREV_TAG..$BRANCH\`):
\`\`\`
$(git --no-pager shortlog -sn --no-merges "$PREV_TAG..$BRANCH" 2>/dev/null)
\`\`\`

Opened by \`scripts/release\`."
    run "opening the pull request" gh pr create --repo "$REPO" --base main \
      --head "$BRANCH" --title "Update version to $TAG_NAME" --body "$PR_BODY"
    ok "opened $(gh pr view "$BRANCH" --repo "$REPO" --json url -q .url 2>/dev/null)"
    PR_OPEN=1
  else
    say "Open the pull request yourself:"
    say "  $COMPARE_URL"
  fi

  MERGED=0
  if [ "$PR_OPEN" = 1 ] && ask_yn "Wait for the checks, then squash-merge it with gh?"; then
    # Checks take a moment to be reported on a new pull request.
    for _ in $(seq 30); do
      gh pr checks "$BRANCH" --repo "$REPO" 2>&1 | grep -q "no checks reported" || break
      sleep 10
    done
    say "  \$ gh pr checks $BRANCH --watch"
    gh pr checks "$BRANCH" --repo "$REPO" --watch --interval 30 ||
      abort "Some checks of the pull request failed. Fix them on $BRANCH, merge it, and tag by hand."
    ok "checks passed"
    run "merging the pull request" gh pr merge "$BRANCH" --repo "$REPO" --squash
    ok "merged"
    MERGED=1
  fi

  if [ "$MERGED" = 0 ]; then
    say "Merge the pull request on GitHub (squash), then come back here."
    while true; do
      ask_yn "Has it been merged?" || { say ""; warn "Stopped before tagging."; summary; manual_from 5; exit 0; }
      if [ "$HAS_GH" = 1 ] &&
        [ "$(gh pr view "$BRANCH" --repo "$REPO" --json state -q .state 2>/dev/null)" != "MERGED" ]; then
        warn "GitHub does not report it as merged yet."
        continue
      fi
      break
    done
  fi

  # The squash merge makes a new commit, so compare contents, not commits:
  # the tag must land on a commit of `main` identical to the release branch.
  run "switching to main" git switch main
  run "pulling main" git pull --ff-only origin main
  git diff --quiet "$BRANCH" main ||
    abort "\`main\` differs from $BRANCH (another pull request merged in between?). Check \`git diff $BRANCH main\` and tag the release commit by hand."
  ok "\`main\` ($(git rev-parse --short main)) matches $BRANCH"

  run "creating the tag" git tag "$TAG_NAME" main
  run "pushing the tag" git push origin "$TAG_NAME"
  ok "pushed $TAG_NAME"
  TAG_COMMIT="$(git rev-parse "$TAG_NAME")"

  # The branch is merged (as a squash), so it is no longer needed.
  git branch -D "$BRANCH" >>"$LOG" 2>&1 && ok "deleted the local branch $BRANCH"
  git push origin --delete "$BRANCH" >>"$LOG" 2>&1 && ok "deleted origin/$BRANCH"
  finish
fi

# ------------------------------------------------------------------------------
# 6. publish the ScalaDoc
# ------------------------------------------------------------------------------
begin 6 "Publish the ScalaDoc to gh-pages"
say "Runs \`sbt ghpagesPushSite\`, which pushes to the gh-pages branch."
if confirm; then
  run "sbt ghpagesPushSite" sbt ghpagesPushSite
  finish
fi

# ------------------------------------------------------------------------------
# done
# ------------------------------------------------------------------------------
[ "$TAG_COMMIT" = "<commit of $TAG_NAME>" ] && \
  TAG_COMMIT="$(git rev-parse "$TAG_NAME" 2>/dev/null || echo "<commit of $TAG_NAME>")"

say ""
rule
say "${GREEN}${BOLD}Steps 1-6 finished for $TAG_NAME.${NC}"
rule
summary
manual_tail
say ""
say "Full log: $LOG"
