def unzip(map: Map[Math -> String]) = {
  let keys = (keys map)[#1]
  let ckeys = (copy keys)[#1]
  let values = (list [])[#1]
  while (! (= (sizeof ckeys) 0)) {
    pop key < ckeys
    let value = map[key]
    push value > values
  }
  let pair = (list [keys, values])[#1]
  return pair
}

@main def main() = {
  let map = (map [Math | BigInt | Number, String] { 1 -> "a", 2n -> "b", 0.3f -> "c" })[#1]
  call pair = clo<"unzip">(map)
  call b0 = clo<"contains">(pair[0], 1)
  assert b0
  call b1 = clo<"contains">(pair[0], 2n)
  assert b1
  call b2 = clo<"contains">(pair[0], 0.3f)
  assert b2
  call b3 = clo<"contains">(pair[1], "a")
  assert b3
  call b4 = clo<"contains">(pair[1], "b")
  assert b4
  call b5 = clo<"contains">(pair[1], "c")
  assert b5
}

def contains(list: List | String, elem: Any): Boolean = {
  let i = 0
  let len = (sizeof list)
  while (< i len) {
    if (= list[i] elem) return true
    i = (+ i 1)
  }
  return false
}
