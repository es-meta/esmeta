let map = @REALM.GlobalObject.__MAP__
assert (= map.x.Value +NUM_INF)
assert (= map.y.Value +NUM_INF)
assert (= map.z.Value +NUM_INF)
assert (= map.w.Value +NUM_INF)
assert (= map.p.Value +NUM_INF)
assert (= map.q.Value +NUM_INF)
assert (= map.r.Value -NUM_INF)
assert (= map.s.Value NaN)
assert (= map.t.Value NaN)
assert (= map.u.Value NaN)
assert (= map.v.Value -NUM_INF)
assert (= (** 10 1e30) +INF)
assert (= (** -10 1e30) +INF)
assert (= (** 0.1 1e30) 0)
assert (= ([number] +INF) +NUM_INF)
assert (= ([number] -INF) -NUM_INF)
assert (= ([approx-number] +INF) +NUM_INF)
assert (= ([approx-number] -INF) -NUM_INF)
assert (= ([approx-number] NaN) NaN)
