# Build the Rocq files generated by `esmeta rocqgen`.
#
# Requires the `cris-workshop` opam switch to be active:
#
#     eval "$(opam env --switch=cris-workshop --set-switch)"
#
# Targets:
#
#     make core    support layer + Signatures.v only (fast feedback loop)
#     make one F=AbsOp_IsCompatiblePropertyDescriptor
#     make proofs  the hand-written Equiv_*.v proofs and what they depend on
#     make funcs   every per-function file (thousands; reports failures)
#     make program the whole-spec CRIS module (very slow; one giant SMod)
#     make clean
#
# Only a focused subset goes through coq_makefile: passing all generated files
# to one coqdep invocation exceeds the 128KB single-argument limit of /bin/sh.
# Per-function files never require one another -- they depend only on the core
# layer -- so `funcs` compiles them directly with coqc instead.

COQ_MAKEFILE := Makefile.coq

# The hand-written support layer, in dependency order, plus the generated
# signature table every function file requires.
CORE := type.v manual_type.v op.v itree_state.v Signatures.v

# Hand-written proofs, and the generated modules they require.
PROOFS := $(wildcard Equiv_*.v) $(wildcard Proto_*.v)
PROOF_DEPS := $(sort $(foreach p,$(PROOFS),\
  $(addsuffix .v,$(shell sed -n 's/^Require Import \(AbsOp_[A-Za-z0-9_]*\)\..*/\1/p' $(p)))))

# Extra per-function modules to pull into the project, e.g. make FOCUS=AbsOp_Foo
FOCUS ?=
FOCUS_VS := $(addsuffix .v,$(FOCUS)) $(addsuffix .v,$(F))

PROJECT_VS := $(sort $(CORE) $(PROOFS) $(PROOF_DEPS) $(FOCUS_VS))

ALL_VS := $(wildcard *.v)
EXCLUDE := $(CORE) $(PROOFS) program.v
FUNCS := $(filter-out $(EXCLUDE), $(ALL_VS))

# Reuse the project options for direct coqc calls so the two stay in sync.
COQC_FLAGS := $(shell grep '^-arg' _CoqProject | sed 's/-arg //g' | tr '\n' ' ') -Q . ""

JOBS ?= 8

.PHONY: configure core one proofs funcs program clean

ifeq ($(MAKECMDGOALS),one)
ifndef F
$(error usage: make one F=<module name without .v>)
endif
endif

# Always regenerated: the project file set depends on FOCUS/F, not just on
# timestamps, so a stale Makefile.coq would silently omit the requested module.
configure:
	@echo "coq_makefile over $(words $(PROJECT_VS)) files"
	@coq_makefile -f _CoqProject $(PROJECT_VS) -o $(COQ_MAKEFILE)

core: configure
	@$(MAKE) -f $(COQ_MAKEFILE) $(CORE:.v=.vo)

one: configure
	@$(MAKE) -f $(COQ_MAKEFILE) $(F).vo

proofs: configure
	@$(MAKE) -f $(COQ_MAKEFILE) $(PROOFS:.v=.vo)

# Compiled directly: too many files for one coqdep invocation, and they are
# independent of each other once `core` is built.
#
# The file list is built inside the shell, never expanded into the recipe: a
# recipe reaches /bin/sh as a single argument, so thousands of names there would
# hit the same 128KB limit that rules out one big coq_makefile.
funcs: core
	@echo "compiling $(words $(FUNCS)) function files with $(JOBS) jobs"
	@find . -maxdepth 1 -name '*.v' -printf '%f\n' \
	  | grep -vxF $(foreach f,$(EXCLUDE),-e $(f)) \
	  | xargs -P $(JOBS) -I{} sh -c 'coqc $(COQC_FLAGS) {} >/dev/null 2>&1 || echo "FAILED {}"' \
	  | tee funcs.failures
	@echo "failures: $$(wc -l < funcs.failures) / $(words $(FUNCS))"

program: configure
	@$(MAKE) -f $(COQ_MAKEFILE) program.vo

clean:
	-$(MAKE) -f $(COQ_MAKEFILE) cleanall
	$(RM) $(COQ_MAKEFILE) $(COQ_MAKEFILE).conf funcs.failures
	$(RM) *.vo *.vok *.vos *.glob .*.aux
